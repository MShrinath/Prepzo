# Application Environment
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Database Configuration
# Defaults to SQLite for immediate local setup; switch to PostgreSQL in production or Docker
DATABASE_URL=sqlite:///./interview_coach.db
# DATABASE_URL=postgresql://user:password@localhost:5432/interviewcoach

# LLM Configuration
# LLM_PROVIDER options: gemini, openai, anthropic, mock (for offline testing/fallback)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro

# API Keys & Custom Endpoints
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# For custom OpenAI-compatible endpoints like aicredits.in, OpenRouter, vLLM:
# OPENAI_BASE_URL=https://aicredits.in/v1

# Voice / Whisper Configuration
# WHISPER_PROVIDER options: openai, mock, local
WHISPER_PROVIDER=mock
WHISPER_MODEL=whisper-1

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
